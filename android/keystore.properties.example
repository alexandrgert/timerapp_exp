# Скопируйте в keystore.properties (файл в .gitignore).
# GitHub Actions подписывает APK ключом из secrets:
#   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
# Пароль ниже — только для локальных sideload-сборок; для Google Play нужен отдельный ключ.
storeFile=keystore/tasktimer-release.jks
storePassword=tasktimer-local-release
keyAlias=tasktimer
keyPassword=tasktimer-local-release
